<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a wallet. Drawn within the inner ~66dp safe zone of
  the 108dp canvas so the launcher's mask never clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wallet body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,40 h48 a6,6 0 0 1 6,6 v22 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-22 a6,6 0 0 1 6,-6 z" />

    <!-- Wallet flap / top fold -->
    <path
        android:fillColor="#E8EAF6"
        android:pathData="M30,40 h44 a4,4 0 0 1 4,4 v4 h-52 v-6 a2,2 0 0 1 4,-2 z" />

    <!-- Card peeking out behind the wallet -->
    <path
        android:fillColor="#C5CAE9"
        android:pathData="M40,34 h34 a4,4 0 0 1 4,4 v4 h-42 v-4 a4,4 0 0 1 4,-4 z" />

    <!-- Snap button / clasp -->
    <path
        android:fillColor="#3F51B5"
        android:pathData="M72,52 h10 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-10 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M77,55 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
